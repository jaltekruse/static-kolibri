{"accessibility_labels":[],"admin_imported":true,"ancestors":[{"id":"c9d7f950ab6b5a1199e3d6c10d7f0103","title":"Khan Academy (English - US curriculum)"},{"id":"7dc4264bc90350aab1229487aaa68065","title":"Math"},{"id":"97c6e2929a6059b1a9008ae0c3ef5d47","title":"AP®︎ Calculus BC"},{"id":"16971c0728555691a33ef395e1824e81","title":"Differentiation: composite, implicit, and inverse functions"},{"id":"5f584c9979835a7289a12f518333e649","title":"The chain rule: introduction"}],"author":"","available":true,"categories":["d&WXdXWF.qs0Xlaxq.8rJ57ht6"],"channel_id":"c9d7f950ab6b5a1199e3d6c10d7f0103","coach_content":false,"content_id":"7aeb039c09cb5b89a0243099996c7ecd","description":"The chain rule states that the derivative of f(g(x)) is f'(g(x))⋅g'(x). In other words, it helps us differentiate *composite functions*. For example, sin(x²) is a composite function because it can be constructed as f(g(x)) for f(x)=sin(x) and g(x)=x². Using the chain rule and the derivatives of sin(x) and x², we can then find the derivative of sin(x²).","duration":306,"grade_levels":["FYxwbxts","ZEjiwvOb"],"id":"602447ac07135c2594c98b0cf2948206","kind":"video","learner_needs":[],"learning_activities":["UD5UGM0z"],"lft":12742,"license_description":"","license_name":"CC BY-NC-SA","license_owner":"Khan Academy","modality":null,"num_coach_contents":0,"on_device_resources":1,"options":{"youtube_id":"0T0QrHO56qg"},"parent":"5f584c9979835a7289a12f518333e649","resource_types":[],"rght":12743,"sort_order":1.0,"title":"Chain rule","tree_id":1,"is_leaf":true,"tags":[],"assessmentmetadata":null,"files":[{"id":"5622ededb54c4c3ba7d12e43cab024b2","preset":"low_res_video","priority":2,"supplementary":false,"thumbnail":false,"file_size":2587075,"available":false,"checksum":"6f834ee237d60a883e10a09fb7998564","extension":"mp4","storage_url":null,"lang":null},{"id":"c3cbbe5791a042a88acccce6842aad88","preset":"video_thumbnail","priority":3,"supplementary":true,"thumbnail":true,"file_size":24130,"available":true,"checksum