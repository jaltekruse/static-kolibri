[{"accessibility_labels":[],"admin_imported":false,"ancestors":[{"id":"c9d7f950ab6b5a1199e3d6c10d7f0103","title":"Khan Academy (English - US curriculum)"},{"id":"7dc4264bc90350aab1229487aaa68065","title":"Math"},{"id":"97c6e2929a6059b1a9008ae0c3ef5d47","title":"AP®︎ Calculus BC"}],"author":"","available":true,"categories":[],"channel_id":"c9d7f950ab6b5a1199e3d6c10d7f0103","coach_content":false,"content_id":"81ec36a6b49c5b4da78b6b333a30ad0c","description":"Limits describe the behavior of a function as we approach a certain input value, regardless of the function's actual value there. Continuity requires that the behavior of a function around a point matches the function's value at that point. These simple yet powerful ideas play a major role in all of calculus.","duration":null,"grade_levels":[],"id":"e7329d7912bc5f90a0161abde041fd25","kind":"topic","learner_needs":[],"learning_activities":[],"lft":12354,"license_description":null,"license_name":null,"license_owner":"","modality":null,"num_coach_contents":0,"on_device_resources":93,"options":{},"parent":"97c6e2929a6059b1a9008ae0c3ef5d47","resource_types":[],"rght":12575,"sort_order":1.0,"title":"Limits and continuity","tree_id":1,"is_leaf":false,"tags":[],"assessmentmetadata":null,"files":[],"lang":{"id":"en","lang_code":"en","lang_direction":"ltr","lang_name":"English","lang_subcode":null},"thumbnail":null},{"accessibility_labels":[],"admin_imported":false,"ancestors":[{"id":"c9d7f950ab6b5a1199e3d6c10d7f0103","title":"Khan Academy (English - US curriculum)"},{"id":"7dc4264bc90350aab1229487aaa68065","title":"Math"},{"id":"97c6e2929a6059b1a9008ae0c3ef5d47","title":"AP®︎ Calculus BC"}],"author":"","available":true,"categories":[],"channel_id":"c9d7f950ab6b5a1199e3d6c10d7f0103","coach_content":false,"content_id":"26387ff0d95d5a09b1d6b92e209b9ed2","description":"The derivative of a function describes the function's instantaneous rate of change at a certain point - it gives us the slope of the line tangent to the function's graph at that point. See how we define the derivative using limits, and learn to find derivatives quickly with the very useful power, product, and quotient rules.","duration":null,"grade_levels":[],"id":"7389ed63938457b39df5256a5bdb0a0a","kind":"topic","learner_needs":[],"learning_activities":[],"lft":12576,"license_description":null,"license_name":null,"license_owner":"","modality":null,"num_coach_contents":0,"on_device_resources":69,"options":{},"parent":"97c6e2929a6059b1a9008ae0c3ef5d47","resource_types":[],"rght":12739,"sort_order":2.0,"title":"Differentiation: definition and basic derivative rules","tree_id":1,"is_leaf":false,"tags":[],"assessmentmetadata":null,"files":[],"lang":{"id":"en","lang_code":"en","lang_direction":"ltr","lang_name":"English","lang_subcode":null},"thumbnail":null},{"accessibility_labels":[],"admin_imported":false,"ancestors":[{"id":"c9d7f950ab6b5a1199e3d6c10d7f0103","title":"Khan Academy (English - US curriculum)"},{"id":"7dc4264bc90350aab1229487aaa68065","title":"Math"},{"id":"97c6e2929a6059b1a9008ae0c3ef5d47","title":"AP®︎ Calculus BC"}],"author":"","available":true,"categories":[],"channel_id":"c9d7f950ab6b5a1199e3d6c10d7f0103","coach_content":false,"content_id":"991b788e50d55614991d5031db745690","description":"The chain rule tells us how to find the derivative of a composite function. This is an exceptionally useful rule, as it opens up a whole world of functions (and equations!) we can now differentiate. Also learn how to use all the different derivative rules together in a thoughtful and strategic manner.","duration":null,"grade_levels":[],"id":"16971c0728555691a33ef395e1824e81","kind":"topic","learner_needs":[],"learning_activities":[],"lft":12740,"license_description":null,"license_name":null,"license_owner":"","modality":null,"num_coach_contents":0,"on_device_resources":53,"options":{},"parent":"97c6e2929a6059b1a9008ae0c3ef5d47","resource_types":[],"rght":12867,"sort_order":3.0,"title":"Differentiation: composite, implicit, and inverse functions","tree_id":1,"is_leaf":false,"tags":[],"assessmentmetadata":null,"files":[],"lang":{"id":"en","lang_code":"en","lang_direction":"ltr","lang_name":"English","lang_subcode":null},"thumbnail":null},{"accessibility_labels":[],"admin_imported":false,"ancestors":[{"id":"c9d7f950ab6b5a1199e3d6c10d7f0103","title":"Khan Academy (English - US curriculum)"},{"id":"7dc4264bc90350aab1229487aaa68065","title":"Math"},{"id":"97c6e2929a6059b1a9008ae0c3ef5d47","title":"AP®︎ Calculus BC"}],"author":"","available":true,"categories":[],"channel_id":"c9d7f950ab6b5a1199e3d6c10d7f0103","coach_content":false,"content_id":"3115fb1056e950dfb5fb033574b07015","description":"Derivatives describe the rate of change of quantities. This comes in handy when solving various problems that are related to rates of change in applied, real-world, situations. You'll also learn how to apply derivatives to approximate function values and find limits using L’Hôpital’s rule.","duration":null,"grade_levels":[],"id":"65ee717ad4bd552390ef8f3424456dd1","kind":"topic","learner_needs":[],"learning_activities":[],"lft":12868,"license_description":null,"license_name":null,"license_owner":"","modality":null,"num_coach_contents":0,"on_device_resources":40,"options":{},"parent":"97c6e2929a6059b1a9008ae0c3ef5d47","resource_types":[],"rght":12965,"sort_order":4.0,"title":"Contextual applications of differentiation","tree_id":1,"is_leaf":false,"tags":[],"assessmentmetadata":null,"files":[],"lang":{"id":"en","lang_code":"en","lang_direction":"ltr","lang_name":"English","lang_subcode":null},"thumbnail":null},{"accessibility_labels":[],"admin_imported":false,"ancestors":[{"id":"c9d7f950ab6b5a1199e3d6c10d7f0103","title":"Khan Academy (English - US curriculum)"},{"id":"7dc4264bc90350aab1229487aaa68065","title":"Math"},{"id":"97c6e2929a6059b1a9008ae0c3ef5d47","title":"AP®︎ Calculus BC"}],"author":"","available":true,"categories":[],"channel_id":"c9d7f950ab6b5a1199e3d6c10d7f0103","coach_content":false,"content_id":"d24bdd2b6d9d531e8c07935493e00387","description":"The first and the second derivative of a function give us all sorts of useful information about that function's behavior. The first derivative tells us where a function increases or decreases or has a maximum or minimum value; the second derivative tells us where a function is concave up or down and where it has inflection points.","duration":null,"grade_levels":[],"id":"068f38431c4253d58fb987a9899a8063","kind":"topic","learner_needs":[],"learning_activities":[],"lft":12966,"license_description":null,"license_name":null,"license_owner":"","modality":null,"num_coach_contents":0,"on_device_resources":64,"options":{},"parent":"97c6e2929a6059b1a9008ae0c3ef5d47","resource_types":[],"rght":13121,"sort_order":5.0,"title":"Applying derivatives to analyze functions","tree_id":1,"is_leaf":false,"tags":[],"assessmentmetadata":null,"files":[],"lang":{"id":"en","lang_code":"en","lang_direction":"ltr","lang_name":"English","lang_subcode":null},"thumbnail":null},{"accessibility_labels":[],"admin_imported":false,"ancestors":[{"id":"c9d7f950ab6b5a1199e3d6c10d7f0103","title":"Khan Academy (English - US curriculum)"},{"id":"7dc4264bc90350aab1229487aaa68065","title":"Math"},{"id":"97c6e2929a6059b1a9008ae0c3ef5d47","title":"AP®︎ Calculus BC"}],"author":"","available":true,"categories":[],"channel_id":"c9d7f950ab6b5a1199e3d6c10d7f0103","coach_content":false,"content_id":"9adbcf643dcb5684b2dc89bbe6ae85ea","description":"The definite integral is an important tool in calculus. It calculates the area under a curve, or the accumulation of a quantity over time. Riemann sums allow us to approximate integrals, while the fundamental theorem of calculus reveals how they connect to derivatives.","duration":null,"grade_levels":[],"id":"ca0a2ff480045a779a60d70a8d67693e","kind":"topic","learner_needs":[],"learning_activities":[],"lft":13122,"license_description":null,"license_name":null,"license_owner":"","modality":null,"num_coach_contents":0,"o