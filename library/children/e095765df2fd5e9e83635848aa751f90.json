[{"accessibility_labels":[],"admin_imported":false,"ancestors":[{"id":"c9d7f950ab6b5a1199e3d6c10d7f0103","title":"Khan Academy (English - US curriculum)"},{"id":"7dc4264bc90350aab1229487aaa68065","title":"Math"},{"id":"0f36fc3e9e4c5f8db14de60a9b52e57d","title":"Geometry"},{"id":"e095765df2fd5e9e83635848aa751f90","title":"Right triangles & trigonometry"}],"author":"","available":true,"categories":[],"channel_id":"c9d7f950ab6b5a1199e3d6c10d7f0103","coach_content":false,"content_id":"02bc2e57941750738ccbbcaa48f0795f","description":"Named after the Greek philosopher who lived nearly 2600 years ago, the Pythagorean theorem is as good as math theorems get (Pythagoras also started a religious movement). It's simple. It's beautiful. It's powerful.In this tutorial, we will cover what it is and how it can be used. We have another tutorial that gives you as many proofs of it as you might need.","duration":null,"grade_levels":[],"id":"812ecde3e3d25bca9da431b8fa94a02e","kind":"topic","learner_needs":[],"learning_activities":[],"lft":5405,"license_description":null,"license_name":null,"license_owner":"","modality":null,"num_coach_contents":0,"on_device_resources":5,"options":{},"parent":"e095765df2fd5e9e83635848aa751f90","resource_types":[],"rght":5416,"sort_order":1.0,"title":"Pythagorean theorem","tree_id":1,"is_leaf":false,"tags":[],"assessmentmetadata":null,"files":[],"lang":{"id":"en","lang_code":"en","lang_direction":"ltr","lang_name":"English","lang_subcode":null},"thumbnail":null},{"accessibility_labels":[],"admin_imported":false,"ancestors":[{"id":"c9d7f950ab6b5a1199e3d6c10d7f0103","title":"Khan Academy (English - US curriculum)"},{"id":"7dc4264bc90350aab1229487aaa68065","title":"Math"},{"id":"0f36fc3e9e4c5f8db14de60a9b52e57d","title":"Geometry"},{"id":"e095765df2fd5e9e83635848aa751f90","title":"Right triangles & trigonometry"}],"author":"","available":true,"categories":[],"channel_id":"c9d7f950ab6b5a1199e3d6c10d7f0103","coach_content":false,"content_id":"8cf2e5d80e6f56e