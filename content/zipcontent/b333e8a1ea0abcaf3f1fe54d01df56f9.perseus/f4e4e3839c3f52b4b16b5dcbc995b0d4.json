{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"We can substitute $x=\\maroonD{8}$ and $y=\\blueE{2}$ into the expression to find its value:\n\n$\\dfrac{x^2}{y^4} \\rightarrow \\dfrac{\\maroonD8^2}{\\blueE2^4} = \\, ?$","images":{},"replace":false,"widgets":{}},{"content":"Now we evaluate:\n\n$\\begin{align}\n\\dfrac{\\maroonD8^2}{\\blueE2^4} \u0026= \\dfrac{64}{16}\n\\\\\\\\\n\u0026=4\n\\end{align}$\n\n[[☃ explanation 1]]","images":{},"replace":false,"widgets":{"explanation 1":{"alignment":"default","graded":true,"options":{"explanation":"$\\begin{align}\n\\dfrac{64}{16} \u0026= \\dfrac{8 \\cdot 8}{8 \\cdot 2}\n\\\\\\\\\n\u0026=\\dfrac88 \\cdot \\dfrac82\n\\\\\\\\\n\u0026= 1 \\cdot 4\n\\\\\\\\\n\u0026=4\n\\end{align}$","hidePrompt":"Hide explanation","showPrompt":"Show me the division.","static":false,"widgets":{}},"static":false,"type":"explanation","version":{"major":0,"minor":0}}}},{"content":"If $x=8$ and $y=2$, then $\\dfrac{x^2}{y^4}=4$.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**What is the value of $\\dfrac{x^2}{y^4}$ when $x=8$ and $y=2$?**\n\n[[☃ numeric-input 1]]","images":{},"widgets":{"numeric-input 1":{"alignment":"default","graded":true,"options":{"answers":[{"maxError":null,"message":"","simplify":"required","status":"correct","strict":false,"value":4}],"coefficient":false,"labelText":"","multipleNumberInput":false,"rightAlign":false,"size":"normal","static":false},"static":false,"type":"numeric-input","version":{"major":0,"minor":0}}}}}
