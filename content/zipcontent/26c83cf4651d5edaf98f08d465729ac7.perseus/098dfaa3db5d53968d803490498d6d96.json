{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"To find the value of $h(\\blueD{-18})$, we need to substitute $\\blueD{x}=\\blueD{-18}$ into the function's formula:\n\n$\\begin{align}h(\\blueD{x})\u0026=17+\\dfrac{\\blueD{x}}{6}\\\\\\\\\nh(\\blueD{-18})\u0026=17+\\dfrac{\\blueD{-18}}{6}\\\\\\\\\n\u0026=17-3\\\\\\\\\n\u0026=14\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$h(-18)=14$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$h(x) = 17+\\dfrac{x}{6}$\n\n$h(-18)=$ [[☃ input-number 1]]","images":{},"widgets":{"input-number 1":{"alignment":"default","graded":true,"options":{"answerType":"number","inexact":false,"maxError":0.1,"simplify":"required","size":"normal","value":14},"static":false,"type":"input-number","version":{"major":0,"minor":0}}}}}
