{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The formula for the derivative of $\\arctan(x)$ is:\n\n$\\dfrac{d}{dx}[\\arctan(x)]=\\dfrac{1}{1+x^2}$","images":{},"replace":false,"widgets":{}},{"content":"Now let's find $\\dfrac{dy}{dx}$:\n\n$\\begin{align}\n\\dfrac{dy}{dx}\u0026=\\dfrac{d}{dx}\\left[\\arctan\\left(-6x\\right)\\right]\n\\\\\\\\\n\u0026=\\dfrac{1}{1+\\left(-6x\\right)^2}\\cdot\\dfrac{d}{dx}\\left[-6x\\right]\n\\\\\\\\\n\u0026=\\dfrac{-6}{1+36x^2}\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion, $\\dfrac{dy}{dx}=\\dfrac{-6}{1+36x^2}$.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$y=\\arctan\\!\\left(-6x\\right)$\n\n$\\dfrac{dy}{dx}=?$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$\\dfrac{1}{-6(1+36x^2)}$","correct":false},{"content":"$\\dfrac{1}{-6(1-6x)}$","correct":false},{"content":"$\\dfrac{-6}{1+36x^2}$","correct":true,"isNoneOfTheAbove":false},{"content":"$\\dfrac{-6}{1-6x}$","correct":false,"isNoneOfTheAbove":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
