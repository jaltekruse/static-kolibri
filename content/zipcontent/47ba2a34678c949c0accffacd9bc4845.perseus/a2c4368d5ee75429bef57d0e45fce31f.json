{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The formula for the derivative of $\\arccos(x)$ is:\n\n$\\dfrac{d}{dx}[\\arccos(x)]=\\dfrac{-1}{\\sqrt{1-x^2}}$","images":{},"replace":false,"widgets":{}},{"content":"Now let's find $g'(x)$:\n\n$\\begin{align}\ng'(x)\u0026=\\dfrac{d}{dx}\\left[\\arccos\\left(2x\\right)\\right]\n\\\\\\\\\n\u0026=\\dfrac{-1}{\\sqrt{1-\\left(2x\\right)^2}}\\cdot\\dfrac{d}{dx}\\left[2x\\right]\n\\\\\\\\\n\u0026=\\dfrac{-2}{\\sqrt{1-4x^2}}\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion, $g'(x)=\\dfrac{-2}{\\sqrt{1-4x^2}}$.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$g(x)=\\arccos\\!\\left(2x\\right)$\n\n$g'(x)=?$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$\\dfrac{-2}{\\sqrt{1-4x^2}}$","correct":true},{"content":"$\\dfrac{2}{\\sqrt{1-4x^2}}$","correct":false},{"content":"$\\dfrac{-2}{\\sqrt{4x^2-1}}$","isNoneOfTheAbove":false},{"content":"$\\dfrac{2}{\\sqrt{4x^2-1}}$","isNoneOfTheAbove":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
