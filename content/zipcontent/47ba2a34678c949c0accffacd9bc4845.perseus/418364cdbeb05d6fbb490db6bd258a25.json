{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The formula for the derivative of $\\arccos(x)$ is:\n\n$\\dfrac{d}{dx}[\\arccos(x)]=\\dfrac{-1}{\\sqrt{1-x^2}}$","images":{},"replace":false,"widgets":{}},{"content":"Now let's find $\\dfrac{d}{dx}\\left[\\arccos\\left(\\dfrac{x}{2}\\right)\\right]$:\n\n$\\begin{align}\n\u0026\\phantom{=}\\dfrac{d}{dx}\\left[\\arccos\\left(\\dfrac{x}{2}\\right)\\right]\n\\\\\\\\\n\u0026=\\dfrac{-1}{\\sqrt{1-\\left(\\dfrac{x}{2}\\right)^2}}\\cdot\\dfrac{d}{dx}\\left[\\dfrac{x}{2}\\right]\n\\\\\\\\\n\u0026=\\dfrac{-1}{2\\sqrt{1-\\dfrac{x^2}{4}}}\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion:\n\n$\\dfrac{d}{dx}\\left[\\arccos\\left(\\dfrac{x}{2}\\right)\\right]=\\dfrac{-1}{2\\sqrt{1-\\dfrac{x^2}{4}}}$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\dfrac{d}{dx}\\left[\\arccos\\left(\\dfrac{x}{2}\\right)\\right]=?$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$\\dfrac{1}{\\sqrt{1-\\dfrac{x^2}{4}}}$","correct":false},{"content":"$\\dfrac{-1}{\\sqrt{1-\\dfrac{x^2}{4}}}$","correct":false},{"content":"$\\dfrac{1}{2\\sqrt{1-\\dfrac{x^2}{4}}}$","correct":false,"isNoneOfTheAbove":false},{"content":"$\\dfrac{-1}{2\\sqrt{1-\\dfrac{x^2}{4}}}$","correct":true,"isNoneOfTheAbove":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
