{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The formula for the derivative of $\\arctan(x)$ is:\n\n$\\dfrac{d}{dx}[\\arctan(x)]=\\dfrac{1}{1+x^2}$","images":{},"replace":false,"widgets":{}},{"content":"Now let's find $f'(x)$:\n\n$\\begin{align}\nf'(x)\u0026=\\dfrac{d}{dx}\\left[\\arctan\\left(3x\\right)\\right]\n\\\\\\\\\n\u0026=\\dfrac{1}{1+\\left(3x\\right)^2}\\cdot\\dfrac{d}{dx}\\left[3x\\right]\n\\\\\\\\\n\u0026=\\dfrac{3}{1+9x^2}\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion, $f'(x)=\\dfrac{3}{1+9x^2}$.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$f(x)=\\arctan\\!\\left(3x\\right)$\n\n$f'(x)=?$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$\\dfrac{3}{1-9x^2}$","correct":false},{"content":"$\\dfrac{-3}{1-9x^2}$","correct":false},{"content":"$\\dfrac{3}{1+9x^2}$","correct":true,"isNoneOfTheAbove":false},{"content":"$\\dfrac{-3}{1+9x^2}$","correct":false,"isNoneOfTheAbove":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
