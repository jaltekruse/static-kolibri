{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The formula for the derivative of $\\arcsin(x)$ is:\n\n$\\dfrac{d}{dx}[\\arcsin(x)]=\\dfrac{1}{\\sqrt{1-x^2}}$","images":{},"replace":false,"widgets":{}},{"content":"Now let's find $h'(x)$:\n\n$\\begin{align}\nh'(x)\u0026=\\dfrac{d}{dx}\\left[\\arcsin\\left(4x\\right)\\right]\n\\\\\\\\\n\u0026=\\dfrac{1}{\\sqrt{1-\\left(4x\\right)^2}}\\cdot\\dfrac{d}{dx}\\left[4x\\right]\n\\\\\\\\\n\u0026=\\dfrac{4}{\\sqrt{1-16x^2}}\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion, $h'(x)=\\dfrac{4}{\\sqrt{1-16x^2}}$.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$h(x)=\\arcsin\\!\\left(4x\\right)$\n\n$h'(x)=?$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$\\dfrac{1}{\\sqrt{1-16x^2}}$","correct":false},{"content":"$\\dfrac{4}{\\sqrt{1-16x^2}}$","correct":true},{"content":"$\\dfrac{1}{\\sqrt{1+16x^2}}$","correct":false,"isNoneOfTheAbove":false},{"content":"$\\dfrac{4}{\\sqrt{1+16x^2}}$","correct":false,"isNoneOfTheAbove":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
