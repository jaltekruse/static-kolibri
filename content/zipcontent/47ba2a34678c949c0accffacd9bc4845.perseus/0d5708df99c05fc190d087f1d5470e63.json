{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The formula for the derivative of $\\arcsin(x)$ is:\n\n$\\dfrac{d}{dx}[\\arcsin(x)]=\\dfrac{1}{\\sqrt{1-x^2}}$","images":{},"replace":false,"widgets":{}},{"content":"Now let's find $\\dfrac{dy}{dx}$:\n\n$\\begin{align}\n\\dfrac{dy}{dx}\u0026=\\dfrac{d}{dx}\\left[\\arcsin\\left(\\dfrac{x}{4}\\right)\\right]\n\\\\\\\\\n\u0026=\\dfrac{1}{\\sqrt{1-\\left(\\dfrac{x}{4}\\right)^2}}\\cdot\\dfrac{d}{dx}\\left[\\dfrac{x}{4}\\right]\n\\\\\\\\\n\u0026=\\dfrac{1}{4\\sqrt{1-\\dfrac{x^2}{16}}}\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion, $\\dfrac{dy}{dx}=\\dfrac{1}{4\\sqrt{1-\\dfrac{x^2}{16}}}$.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$y=\\arcsin\\!\\left(\\dfrac{x}{4}\\right)$\n\n$\\dfrac{dy}{dx}=?$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$\\dfrac{1}{\\sqrt{1-\\dfrac{x^2}{16}}}$","correct":false},{"content":"$\\dfrac{1}{4\\sqrt{1-\\dfrac{x^2}{16}}}$","correct":true},{"content":"$\\dfrac{1}{\\sqrt{1-\\dfrac{x^2}{4}}}$","correct":false,"isNoneOfTheAbove":false},{"content":"$\\dfrac{1}{4\\sqrt{1-\\dfrac{x^2}{4}}}$","correct":false,"isNoneOfTheAbove":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
