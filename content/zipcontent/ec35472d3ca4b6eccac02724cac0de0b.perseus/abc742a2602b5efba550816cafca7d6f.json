{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Start with the Maclaurin series for $\\cos(x)$.\n\n$\\displaystyle\\cos x=1-\\frac{{{x}^{2}}}{2!}+\\frac{{{x}^{4}}}{4!}-...+{{\\left( -1 \\right)}^{n}}\\frac{{{x}^{2n}}}{\\left( 2n \\right)!}+...$","images":{},"replace":false,"widgets":{}},{"content":"Multiply the series by $x$.\n\n$\\displaystyle x\\cos x=x-\\frac{{{x}^{3}}}{2!}+\\frac{{{x}^{5}}}{4!}-...+{{\\left( -1 \\right)}^{n}}\\frac{{{x}^{2n+1}}}{\\left( 2n \\right)!}+...$","images":{},"replace":false,"widgets":{}},{"content":"The first three terms are\n\n$x-\\dfrac{{{x}^{3}}}{2!}+\\dfrac{{{x}^{5}}}{4!}$.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**What are the first three non-zero terms of the Maclaurin series for the function $f(x)=x\\cos(x)$?**\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$\\displaystyle x+x^2+\\frac{x^3}{2!}$","correct":false},{"content":"$\\displaystyle x-\\frac{{{x}^{4}}}{3!}+\\frac{{{x}^{6}}}{5!}$","correct":false},{"content":"$\\displaystyle x-\\frac{{{x}^{3}}}{2!}+\\frac{{{x}^{5}}}{4!}$","correct":true},{"content":"$\\displaystyle x+\\frac{{{x}^{3}}}{2!}-\\frac{{{x}^{5}}}{4!}$","correct":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"onePerLine":true,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
