{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Complex numbers are multiplied like any two binomials.","images":{},"replace":false,"widgets":{}},{"content":"First use the distributive property:\n\n  $\\qquad (\\pink{-1-3i}) \\cdot (\\blue{-1+i}) = $\n \n $ \\qquad \\qquad (\\pink{-1} \\cdot \\blue{-1}) + (\\pink{-1} \\cdot \\blue{i}) + (\\pink{-3i} \\cdot \\blue{-1}) + (\\pink{-3i} \\cdot \\blue{i}) $","images":{},"replace":false,"widgets":{}},{"content":"Then simplify the terms:\n\n $ \\qquad (1) + (-i) + (3i) + (-3i^2) $","images":{},"replace":false,"widgets":{}},{"content":"Imaginary unit multiples can be grouped together.\n\n $ \\qquad 1 + (-1 + 3)i - 3 i^2 $","images":{},"replace":false,"widgets":{}},{"content":"After we plug in $i^2 = -1$, the result becomes\n\n $ 1 + (-1 + 3)i - (-3) $","images":{},"replace":false,"widgets":{}},{"content":"The result is simplified: $ (1 + 3) + (2i) = 4+2i $","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Multiply and simplify the following complex numbers:**\n\n $(\\pink{-1-3i}) \\cdot (\\blue{-1+i})$\n\n[[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"4+2i"}],"buttonSets":["basic"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
