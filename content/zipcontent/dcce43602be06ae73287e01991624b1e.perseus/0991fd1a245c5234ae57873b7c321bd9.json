{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Complex numbers are multiplied like any two binomials.","images":{},"replace":false,"widgets":{}},{"content":"First use the distributive property:\n\n  $\\qquad (\\pink{-4-4i}) \\cdot (\\blue{-5-3i}) = $\n \n $ \\qquad \\qquad (\\pink{-4} \\cdot \\blue{-5}) + (\\pink{-4} \\cdot \\blue{-3i}) + (\\pink{-4i} \\cdot \\blue{-5}) + (\\pink{-4i} \\cdot \\blue{-3i}) $","images":{},"replace":false,"widgets":{}},{"content":"Then simplify the terms:\n\n $ \\qquad (20) + (12i) + (20i) + (12i^2) $","images":{},"replace":false,"widgets":{}},{"content":"Imaginary unit multiples can be grouped together.\n\n $ \\qquad 20 + (12 + 20)i + 12 i^2 $","images":{},"replace":false,"widgets":{}},{"content":"After we plug in $i^2 = -1$, the result becomes\n\n $ 20 + (12 + 20)i - 12 $","images":{},"replace":false,"widgets":{}},{"content":"The result is simplified: $ (20 - 12) + (32i) = 8+32i $","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Multiply and simplify the following complex numbers:**\n\n $(\\pink{-4-4i}) \\cdot (\\blue{-5-3i})$\n\n[[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"8+32i"}],"buttonSets":["basic"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
