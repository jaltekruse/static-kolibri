{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Complex numbers are multiplied like any two binomials.","images":{},"replace":false,"widgets":{}},{"content":"First use the distributive property:\n\n  $\\qquad (\\pink{4+4i}) \\cdot (\\blue{-2-5i}) = $\n \n $ \\qquad \\qquad (\\pink{4} \\cdot \\blue{-2}) + (\\pink{4} \\cdot \\blue{-5i}) + (\\pink{4i} \\cdot \\blue{-2}) + (\\pink{4i} \\cdot \\blue{-5i}) $","images":{},"replace":false,"widgets":{}},{"content":"Then simplify the terms:\n\n $ \\qquad (-8) + (-20i) + (-8i) + (-20i^2) $","images":{},"replace":false,"widgets":{}},{"content":"Imaginary unit multiples can be grouped together.\n\n $ \\qquad -8 + (-20 - 8)i - 20 i^2 $","images":{},"replace":false,"widgets":{}},{"content":"After we plug in $i^2 = -1$, the result becomes\n\n $ -8 + (-20 - 8)i - (-20) $","images":{},"replace":false,"widgets":{}},{"content":"The result is simplified: $ (-8 + 20) + (-28i) = 12-28i $","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Multiply and simplify the following complex numbers:**\n\n $(\\pink{4+4i}) \\cdot (\\blue{-2-5i})$\n\n[[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"12-28i"}],"buttonSets":["basic"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
