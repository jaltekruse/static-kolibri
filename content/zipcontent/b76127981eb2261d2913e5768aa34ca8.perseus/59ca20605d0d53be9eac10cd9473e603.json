{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"To find the $x$-value that corresponds to $\\maroonD{y}=\\maroonD{-4}$, let's substitute this $y$-value in the equation.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}6x+7\\maroonD{y}\u0026=4x+4\\maroonD{y}\\\\\n6x+7\\cdot(\\maroonD{-4})\u0026=4x+4\\cdot(\\maroonD{-4})\\\\\n6x-28\u0026=4x-16\\\\\n2x\u0026=12\\\\\nx\u0026=6\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"Therefore $(6,-4)$ is a solution of the equation.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$6x+7y=4x+4y$\n\n**Complete the missing value in the solution to the equation.**\n\n$($ [[☃ numeric-input 2]] $,-4)$","images":{},"widgets":{"numeric-input 2":{"alignment":"default","graded":true,"options":{"answers":[{"maxError":null,"message":"","simplify":"required","status":"correct","strict":false,"value":6}],"coefficient":false,"labelText":"input","size":"small","static":false},"static":false,"type":"numeric-input","version":{"major":0,"minor":0}}}}}
