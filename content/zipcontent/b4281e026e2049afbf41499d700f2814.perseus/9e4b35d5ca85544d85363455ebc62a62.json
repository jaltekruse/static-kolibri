{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"We need to manipulate the equation to get $a$ by itself.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align} 5 + 14a \u0026= 9a - 5 \\\\\\\\\n5 + 14a \\blueD{- 9a} \u0026= 9a - 5 \\blueD{- 9a} \u0026\u0026\\small\\gray{\\text{Subtract $9a$ from each side.}}\\\\\\\\\n5 + 5a \u0026= -5 \u0026\u0026\\small\\gray{\\text{Combine like terms.}}\\\\\\\\\n5 + 5a \\blueD{-5} \u0026= -5 \\blueD{- 5} \u0026\u0026\\small\\gray{\\text{Subtract $5$ from each side.}}\\\\\\\\\n5a \u0026= -10 \u0026\u0026\\small\\gray{\\text{Combine like terms.}}\\\\\\\\\n\\dfrac{5a}{\\blueD5} \u0026= \\dfrac{-10}{\\blueD5} \u0026\u0026\\small\\gray{\\text{Divide each side by $5$.}}\\\\\\\\\na \u0026= \\greenD{-2} \u0026\u0026\\small\\gray{\\text{Simplify.}}\\\\\\\\\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"**The answer:**\n\n\u003e$a = \\greenD{-2}~~~~~~~~$ [[☃ explanation 1]]","images":{},"replace":false,"widgets":{"explanation 1":{"alignment":"default","graded":true,"options":{"explanation":"$\\begin{align} 5 + 14a \u0026= 9a - 5 \\\\\\\\\n5 + 14(\\greenD{-2}) \u0026\\stackrel?= 9(\\greenD{-2}) - 5 \\\\\\\\\n5 + (-28) \u0026\\stackrel?= -18 - 5 \\\\\\\\\n-23 \u0026= -23 ~~~~~~~\\text{Yes!}\n\\end{align}$","hidePrompt":"Okay, got it","showPrompt":"Let's check our work!","static":false,"widgets":{}},"static":false,"type":"explanation","version":{"major":0,"minor":0}}}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Solve for $a$.**\n\n$5 + 14a = 9a - 5$\n\n$a =$ [[☃ numeric-input 1]]","images":{},"widgets":{"numeric-input 1":{"alignment":"default","graded":true,"options":{"answers":[{"maxError":null,"message":"","simplify":"optional","status":"correct","strict":false,"value":-2}],"coefficient":false,"labelText":"","multipleNumberInput":false,"rightAlign":false,"size":"normal","static":false},"static":false,"typ