{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"$\\sqrt[3]{27}$ is the number that, when multiplied by itself three times, equals $27$.","images":{},"replace":false,"widgets":{}},{"content":"If you can't think of that number, you can break down $27$ into its prime factorization and look for equal groups of numbers.","images":{},"replace":false,"widgets":{}},{"content":"Let's draw a factor tree.\n\n\n\n[[☃ image 1]]\n\n","images":{},"replace":false,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for twenty-seven. It starts with just the number twenty-seven.","backgroundImage":{"height":180,"url":"web+graphie:${☣ LOCALPATH}/images/1bd83880522911ef39283076c250aa789876411c","width":150},"box":[150,180],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"\n\n[[☃ image 1]]\n\n","images":{},"replace":true,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for twenty-seven. Twenty-seven is the product of three and nine. The three is circled.","backgroundImage":{"height":180,"url":"web+graphie:${☣ LOCALPATH}/images/12313f7da9c94ab1e3200d715335a8b28a6a9631","width":150},"box":[150,180],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"\n\n[[☃ image 1]]\n\n","images":{},"replace":true,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for twenty-seven. Twenty-seven is the product of three and nine. The three is circled. Nine is the product of three and three. The first three is circled.","backgroundImage":{"height":180,"url":"web+graphie:${☣ LOCALPATH}/images/2f1bc13e360b945dfd97c34e425d4bb391cacf6e","width":150},"box":[150,180],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"\n\n[[☃ image 1]]\n\n","images":{},"replace":true,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for twenty-seven. Twenty-seven is the product of three and nine. The three is circled. Nine is the product of three and three. Both threes are circled.","backgroundImage":{"height":180,"url":"web+graphie:${☣ LOCALPATH}/images/eac3d011c722e2a7ac7995b0cdae27dc8edeb215","width":150},"box":[150,180],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"So the prime factorization of $27$ is $3\\times 3\\times 3$.","images":{},"replace":false,"widgets":{}},{"content":"We're looking for $\\sqrt[3]{27}$, so we want to split the prime factors into three identical groups.","images":{},"replace":false,"widgets":{}},{"content":"We only have three prime factors, and we want to split them into three groups, so this is easy.","images":{},"replace":false,"widgets":{}},{"content":"$27 = 3\\times 3\\times 3$, so $3^3 = 27$.","images":{},"replace":false,"widgets":{}},{"content":"So $\\sqrt[3]{27}$ is $3$.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**$\\sqrt[3]{27} =$** [[☃ numeric-input 1]]","images":{},"widgets":{"numeric-input 1":{"alignment":"default","graded":true,"options":{"answers":[{"maxError":0,"message":"","simplify":true,"status":"correct","strict":false,"value":3}],"coefficient":false,"labelText":"","multipleNumberInput":false,"rightAlign":false,"size":"normal","static":false},"static":false,"type":"numeric-input","version":{"major":0,"minor":0}}}}}
