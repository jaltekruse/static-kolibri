{"answerArea":{"calculator":true,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"$\\tan(x)$ is continuous on all points in its domain.\n\nTherefore, if $x=-\\dfrac{\\pi}{2}$ is within the domain of $\\tan(x)$, we can find $\\displaystyle\\lim_{x\\to -\\frac{\\pi}{2}}\\tan(x)$ by direct substitution.","images":{},"replace":false,"widgets":{}},{"content":"$x=-\\dfrac{\\pi}{2}$ is *not* in the domain of $\\tan(x)$:\n\n$\\begin{align}\n\\tan\\left(-\\dfrac{\\pi}{2}\\right)\u0026=\\dfrac{\\sin\\left(-\\dfrac{\\pi}{2}\\right)}{\\cos\\left(-\\dfrac{\\pi}{2}\\right)}\n\\\\\\\\\n\u0026=\\dfrac{-1}{0}\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"Since direct substitution ends with $\\dfrac{-1}{0}$, we know that $\\displaystyle\\lim_{x\\to -\\frac{\\pi}{2}}\\tan(x)$ doesn't exist.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\displaystyle\\lim_{x\\to -\\frac{\\pi}{2}}\\tan(x)=?$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$-1$","correct":false},{"content":"$-\\dfrac{1}{2}$","correct":false},{"content":"$0$","correct":false,"isNoneOfTheAbove":false},{"content":"The limit doesn't exist.","correct":true,"isNoneOfTheAbove":false}],"countChoices":false,"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
