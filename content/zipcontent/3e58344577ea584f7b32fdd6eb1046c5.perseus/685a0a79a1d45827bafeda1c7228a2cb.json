{"answerArea":{"calculator":true,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"$\\tan(x)$ is continuous on all points in its domain.\n\nTherefore, if $x=0$ is within the domain of $\\tan(x)$, we can find $\\displaystyle\\lim_{x\\to 0}\\tan(x)$ by direct substitution.","images":{},"replace":false,"widgets":{}},{"content":"$x=0$ is indeed in the domain of $\\tan(x)$:\n\n$\\begin{align}\n\\tan\\left(0\\right)\u0026=\\dfrac{\\sin\\left(0\\right)}{\\cos\\left(0\\right)}\n\\\\\\\\\n\u0026=\\dfrac{0}{1}\n\\\\\\\\\n\u0026=0\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"$\\displaystyle\\lim_{x\\to 0}\\tan(x)=0$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\displaystyle\\lim_{x\\to 0}\\tan(x)=?$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$-1$","correct":false},{"content":"$0$","correct":true},{"content":"$1$","correct":false,"isNoneOfTheAbove":false},{"content":"The limit doesn't exist.","correct":false,"isNoneOfTheAbove":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
