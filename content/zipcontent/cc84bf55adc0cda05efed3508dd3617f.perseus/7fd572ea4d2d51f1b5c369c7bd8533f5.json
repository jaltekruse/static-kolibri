{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"We need to evaluate this sum for $k$-values from $0$ through $3$. \n\nWe don't know the value of $j$, so we will leave that variable in our expressions.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\\displaystyle\\sum_{k=0}^3 \\dfrac{6k}{j-2}\u0026= \\dfrac{6(0)}{j-2} + \\dfrac{6(1)}{j-2} + \\dfrac{6(2)}{j-2} + \\dfrac{6(3)}{j-2}\n\\\\\\\\\n\u0026= 0 +  \\dfrac{6}{j-2} +  \\dfrac{12}{j-2} +  \\dfrac{18}{j-2}\n\\end{align}$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\displaystyle\\sum_{k=0}^3 \\dfrac{6k}{j-2}=\\,?$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"clue":"This mixes up the $k$ and $j$ values.","content":"$0 +  \\dfrac{6}{k-2} +  \\dfrac{12}{k-2} +  \\dfrac{18}{k-2}$","correct":false},{"clue":"We should only substitute into $k$, because it is the index, and not into $j$. Also, dividing by $0$ is undefined.","content":"$0-6+0+18$","correct":false},{"clue":"This mixes up the $k$ and $j$ values.  Also, the starting index should be $0$, not $1$, in this case.","content":"$\\dfrac{6}{k-2} +  \\dfrac{12}{k-2} +  \\dfrac{18}{k-2}+\\dfrac{24}{k-2}$","correct":false,"isNoneOfTheAbove":false},{"content":"$0 +  \\dfrac{6}{j-2} +  \\dfrac{12}{j-2} +  \\dfrac{18}{j-2}$","correct":true,"isNoneOfTheAbove":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
