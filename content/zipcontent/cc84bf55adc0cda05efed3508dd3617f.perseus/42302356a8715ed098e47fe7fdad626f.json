{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"We need to evaluate this sum for $j$-values from $1$ through $4$. \n\nWe don't know the value of $i$, so we will leave that variable in our expressions.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\displaystyle\\sum_{j=1}^4 (2ij+8j)^2\n\\\\\\\\\n\u0026= (2i(1)+8(1))^2 + (2i(2)+8(2))^2 + (2i(3)+8(3))^2 + (2i(4)+8(4))^2\n\\\\\\\\\n\u0026= (2i+8)^2+(4i+16)^2+(6i+24)^2+(8i+32)^2\n\\end{align}$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\displaystyle\\sum_{j=1}^4 (2ij+8j)^2=\\,?$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"clue":"We should only substitute into $j$, because it is the index, and not into $i$.","content":"$10^2+24^2+42^2+64^2$","correct":false},{"clue":"We should substitute the index into *every* instance of $j$ in the expression before we increase the index.","content":"$(2i+16)^2+(6i+32)^2+(10i+48)^2+(14i+64)^2$","correct":false},{"content":"$ (2i+8)^2+(4i+16)^2+(6i+24)^2+(8i+32)^2$","correct":true,"isNoneOfTheAbove":false},{"clue":"We should substitute into $j$, because it is the index, and not into $i$.","content":"$(10j)^2+(12j)^2+(14j)^2+(16j)^2$","correct":false,"isNoneOfTheAbove":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
