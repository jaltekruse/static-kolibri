{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"We can expand this expression using the \"perfect square\" pattern (where $P$ and $Q$ can be any monomial):\n\n$(P+Q)^2=P^2+2PQ+Q^2$\n\n[[☃ explanation 1]]","images":{},"replace":false,"widgets":{"explanation 1":{"alignment":"default","graded":true,"options":{"explanation":"$\\begin{align}\n\u0026\\phantom{=}(P+Q)^2\n\\\\\\\\\n\u0026=(P+Q)(P+Q)\n\\\\\\\\\n\u0026=P(P+Q)+Q(P+Q)\n\\\\\\\\\n\u0026=P^2+P\\cdot Q+Q\\cdot P+Q^2\n\\\\\\\\\n\u0026=P^2+2PQ+Q^2\n\\end{align}$","hidePrompt":"Got it, thanks!","showPrompt":"Show me why this is true.","static":false,"widgets":{}},"static":false,"type":"explanation","version":{"major":0,"minor":0}}}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\left(6y^2+5y^4\\right)^2\n\\\\\\\\\n\u0026=\\left(6y^2\\right)^2+2\\left(6y^2\\right)\\left(5y^4\\right)+\\left(5y^4\\right)^2\n\\\\\\\\\n\u0026=36y^4+60y^6+25y^8\n\\\\\\\\\n\u0026=25y^8+60y^6+36y^4\n\\end{align}$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Expand and combine like terms.**\n\n$(6y^2+5y^4)^2=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"buttonSets":["basic","prealgebra"],"buttonsVisible":"focused","considered":"correct","form":true,"functions":["f","g","h"],"key":0,"linterContext":{"contentType":"","highlightLint":false,"paths":[],"stack":[]},"simplify":false,"times":false,"value":"25y^{8}+60y^{6}+36y^{4}"}],"buttonSets":["basic","prealgebra"],"functions":["f","g","h"],"static":false,"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
