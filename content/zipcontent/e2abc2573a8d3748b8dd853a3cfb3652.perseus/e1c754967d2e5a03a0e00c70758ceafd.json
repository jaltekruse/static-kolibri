{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"We can expand this expression using the \"perfect square\" pattern (where $P$ and $Q$ can be any monomial):\n\n$(P+Q)^2=P^2+2PQ+Q^2$\n\n[[☃ explanation 1]]","images":{},"replace":false,"widgets":{"explanation 1":{"alignment":"default","graded":true,"options":{"explanation":"$\\begin{align}\n\u0026\\phantom{=}(P+Q)^2\n\\\\\\\\\n\u0026=(P+Q)(P+Q)\n\\\\\\\\\n\u0026=P(P+Q)+Q(P+Q)\n\\\\\\\\\n\u0026=P^2+P\\cdot Q+Q\\cdot P+Q^2\n\\\\\\\\\n\u0026=P^2+2PQ+Q^2\n\\end{align}$","hidePrompt":"Got it, thanks!","showPrompt":"Show me why this is true.","static":false,"widgets":{}},"static":false,"type":"explanation","version":{"major":0,"minor":0}}}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\left(5+6b^3\\right)^2\n\\\\\\\\\n\u0026=\\left(5\\right)^2+2\\left(5\\right)\\left(6b^3\\right)+\\left(6b^3\\right)^2\n\\\\\\\\\n\u0026=25+60b^3+36b^6\n\\\\\\\\\n\u0026=36b^6+60b^3+25\n\\end{align}$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Expand and combine like terms.**\n\n$(5+6b^3)^2=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"buttonSets":["basic","prealgebra"],"buttonsVisible":"focused","considered":"correct","form":true,"functions":["f","g","h"],"key":0,"linterContext":{"contentType":"","highlightLint":false,"paths":[],"stack":[]},"simplify":false,"times":false,"value":"36b^{6}+60b^{3}+25"}],"buttonSets":["basic","prealgebra"],"functions":["f","g","h"],"static":false,"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
