{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"$\\sqrt{9}$ is the number that, when multiplied by itself, equals $9$.","images":{},"replace":false,"widgets":{}},{"content":"If you can't think of that number, you can break down $9$ into its prime factorization and look for equal groups of numbers.","images":{},"replace":false,"widgets":{}},{"content":"Let's draw a factor tree.\n\n\n\n[[☃ image 1]]\n\n","images":{},"replace":false,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for nine. It starts with just the number nine.","backgroundImage":{"height":120,"url":"web+graphie:${☣ LOCALPATH}/images/421e111441078f87503eeb2ac4a6fba10ad98bfc","width":120},"box":[120,120],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"\n\n[[☃ image 1]]\n\n","images":{},"replace":true,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for nine. The number nine is the product of three and three. The first three is circled.","backgroundImage":{"height":120,"url":"web+graphie:${☣ LOCALPATH}/images/2831169ecaa541c300943bd1af1093fb75f3b80d","width":120},"box":[120,120],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"\n\n[[☃ image 1]]\n\n","images":{},"replace":true,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for nine. The number nine is the product of three and three. Both threes are circled.","backgroundImage":{"height":120,"url":"web+graphie:${☣ LOCALPATH}/images/111a920b37558f371df99a0991d577e4c5541760","width":120},"box":[120,120],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"So the prime factorization of $9$ is $3\\times 3$.","images":{},"replace":false,"widgets":{}},{"content":"We're looking for $\\sqrt{9}$, so we want to split the prime factors into two identical groups.","images":{},"replace":false,"widgets":{}},{"content":"We only have two prime factors, and we want to split them into two groups, so this is easy.","images":{},"replace":false,"widgets":{}},{"content":"$9 = 3\\times 3$, so $3^2 = 9$.","images":{},"replace":false,"widgets":{}},{"content":"So $\\sqrt{9}$ is $3$.\n\n[[☃ explanation 1]]","images":{},"replace":false,"widgets":{"explanation 1":{"alignment":"default","graded":true,"options":{"explanation":"Since $(-3)\\cdot(-3)=9$, it's reasonable to say that $-3$ is also the square root of $9$. However, when we see notation like \"$\\sqrt{9}$\", it's customary to only take the principal (positive) square root.","hidePrompt":"Got it, thanks!","showPrompt":"What about -3?","static":false,"widgets":{}},"static":false,"type":"explanation","version":{"major":0,"minor":0}}}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Find the square root.**\n\n**$\\sqrt{9} =$** [[☃ numeric-input 1]]","images":{},"widgets":{"numeric-input 1":{"alignment":"default","graded":true,"options":{"answers":[{"maxError":0,"message":"","simplify":true,"status":"correct","strict":false,"value":3}],"coefficient":false,"labelText":"","multipleNumberInput":false,"rightAlign":false,"size":"normal","static":false},"static":false,"type":"numeric-input","version":{"major":0,"minor":0}}}}}
