{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"$\\sqrt{25}$ is the number that, when multiplied by itself, equals $25$.","images":{},"replace":false,"widgets":{}},{"content":"If you can't think of that number, you can break down $25$ into its prime factorization and look for equal groups of numbers.","images":{},"replace":false,"widgets":{}},{"content":"Let's draw a factor tree.\n\n\n\n[[☃ image 1]]\n\n","images":{},"replace":false,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for twenty-five. It starts with just the number twenty-five.","backgroundImage":{"height":120,"url":"web+graphie:${☣ LOCALPATH}/images/f450eba0deb2808e7350103a4b8ae9fec47260e1","width":120},"box":[120,120],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"![](web+graphie:${☣ LOCALPATH}/images/41675e7a60eea51dbd3fdfb98c46efadd5531812)","images":{"web+graphie:${☣ LOCALPATH}/images/41675e7a60eea51dbd3fdfb98c46efadd5531812":{"height":120,"width":120}},"replace":true,"widgets":{}},{"content":"\n\n[[☃ image 1]]\n\n","images":{},"replace":true,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for twenty-five. Twenty-five is a product of five and five. Both fives are circled.","backgroundImage":{"height":120,"url":"web+graphie:${☣ LOCALPATH}/images/192b6ba5aa0fc40bcbeeaa4642b3f4a1968aff1e","width":120},"box":[120,120],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"So the prime factorization of $25$ is $5\\times 5$.","images":{},"replace":false,"widgets":{}},{"content":"We're looking for $\\sqrt{25}$, so we want to split the prime factors into two identical groups.","images":{},"replace":false,"widgets":{}},{"content":"We only have two prime factors, and we want to split them into two groups, so this is easy.","images":{},"replace":false,"widgets":{}},{"content":"$25 = 5\\times 5$, so $5^2 = 25$.","images":{},"replace":false,"widgets":{}},{"content":"So $\\sqrt{25}$ is $5$.\n\n[[☃ explanation 1]]","images":{},"replace":false,"widgets":{"explanation 1":{"alignment":"default","graded":true,"options":{"explanation":"Since $(-5)\\cdot(-5)=25$, it's reasonable to say that $-5$ is also the square root of $25$. However, when we see notation like \"$\\sqrt{25}$\", it's customary to only take the principal (positive) square root.","hidePrompt":"Got it, thanks!","showPrompt":"What about -5?","static":false,"widgets":{}},"static":false,"type":"explanation","version":{"major":0,"minor":0}}}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Find the square root.**\n\n**$\\sqrt{25} =$** [[☃ numeric-input 1]]","images":{},"widgets":{"numeric-input 1":{"alignment":"default","graded":true,"options":{"answers":[{"maxError":0,"message":"","simplify":true,"status":"correct","strict":false,"value":5}],"coefficient":false,"labelText":"","multipleNumberInput":false,"rightAlign":false,"size":"normal","static":false},"static":false,"type":"numeric-input","version":{"major":0,"minor":0}}}}}
