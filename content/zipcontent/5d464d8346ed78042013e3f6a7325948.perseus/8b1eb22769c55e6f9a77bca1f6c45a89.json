{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"$\\sqrt{49}$ is the number that, when multiplied by itself, equals $49$.","images":{},"replace":false,"widgets":{}},{"content":"If you can't think of that number, you can break down $49$ into its prime factorization and look for equal groups of numbers.","images":{},"replace":false,"widgets":{}},{"content":"Let's draw a factor tree.\n\n\n\n[[☃ image 1]]\n\n","images":{},"replace":false,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for forty-nine. It starts with just the number forty-nine.","backgroundImage":{"height":120,"url":"web+graphie:${☣ LOCALPATH}/images/f0fb79ca2e9a4268056ab04cca02ebad32942ed3","width":120},"box":[120,120],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"\n\n[[☃ image 1]]\n\n","images":{},"replace":true,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for forty-nine. Forty-nine is the product of seven and seven. The first seven is circled.","backgroundImage":{"height":120,"url":"web+graphie:${☣ LOCALPATH}/images/d390de02f618bbac02de91c324628b0f0def253c","width":120},"box":[120,120],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"\n\n[[☃ image 1]]\n\n","images":{},"replace":true,"widgets":{"image 1":{"alignment":"block","graded":true,"options":{"alt":"A factor tree for forty-nine. Forty-nine is the product of seven and seven. Both sevens are circled.","backgroundImage":{"height":120,"url":"web+graphie:${☣ LOCALPATH}/images/e290114d85dae0862525c70a4ccb5a4e99cfe0b2","width":120},"box":[120,120],"caption":"","labels":[],"range":[[0,10],[0,10]],"static":false,"title":""},"static":false,"type":"image","version":{"major":0,"minor":0}}}},{"content":"So the prime factorization of $49$ is $7\\times 7$.","images":{},"replace":false,"widgets":{}},{"content":"We're looking for $\\sqrt{49}$, so we want to split the prime factors into two identical groups.","images":{},"replace":false,"widgets":{}},{"content":"We only have two prime factors, and we want to split them into two groups, so this is easy.","images":{},"replace":false,"widgets":{}},{"content":"$49 = 7\\times 7$, so $7^2 = 49$.","images":{},"replace":false,"widgets":{}},{"content":"So $\\sqrt{49}$ is $7$.\n\n[[☃ explanation 1]]","images":{},"replace":false,"widgets":{"explanation 1":{"alignment":"default","graded":true,"options":{"explanation":"Since $(-7)\\cdot(-7)=49$, it's reasonable to say that $-7$ is also the square root of $49$. However, when we see notation like \"$\\sqrt{49}$\", it's customary to only take the principal (positive) square root.","hidePrompt":"Got it, thanks!","showPrompt":"What about -7?","static":false,"widgets":{}},"static":false,"type":"explanation","version":{"major":0,"minor":0}}}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Find the square root.**\n\n**$\\sqrt{49} =$** [[☃ numeric-input 1]]","images":{},"widgets":{"numeric-input 1":{"alignment":"default","graded":true,"options":{"answers":[{"maxError":0,"message":"","simplify":true,"status":"correct","strict":false,"value":7}],"coefficient":false,"labelText":"","multipleNumberInput":false,"rightAlign":false,"size":"normal","static":false},"static":false,"type":"numeric-input","version":{"major":0,"minor":0}}}}}
