{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Get the equation into the form $ax^2 + bx + c = 0$:\n\n$\\begin{align}\n-6 + 3x - 9x^2 \u0026= -16\n\\\\\\\\\n10 + 3x - 9x^2 \u0026= 0\n\\\\\\\\\n-9x^{2}+3x+10 \u0026= 0\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"Use the quadratic formula to solve $ax^2 + bx + c = 0$:\n\n$x = \\dfrac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}$\n\nIn our case, $a = -9, b = 3, c = 10$","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\nx\u0026=\\dfrac{-3 \\pm \\sqrt{3^{2} - 4 \\cdot -9 \\cdot 10}}{2 \\cdot -9}\n\\\\\\\\\n\u0026= \\dfrac{-3 \\pm \\sqrt{369}}{-18}\n\\\\\\\\\n\u0026= \\dfrac{-3 \\pm 3\\sqrt{41}}{-18}\n\\\\\\\\\n\u0026=\\dfrac{-1 \\pm \\sqrt{41}}{-6}\n\\end{align}$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Solve.**\n\n$-6 + 3x - 9x^2 = -16$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$x =\\dfrac{7 \\pm \\sqrt{77}}{2}$","correct":false},{"content":"$x =\\dfrac{-5 \\pm \\sqrt{305}}{14}$","correct":false},{"content":"$x =\\dfrac{-1 \\pm 2\\sqrt{2}}{-7}$","correct":false},{"content":"$x =\\dfrac{-1 \\pm \\sqrt{41}}{-6}$","correct":true}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"onePerLine":true,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
