{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Get the equation into the form $ax^2 + bx + c = 0$:\n\n$\\begin{align}\n6- 6x^2- 3x \u0026= 0\n\\\\\\\\\n-6x^{2}-3x+6 \u0026= 0\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"Use the quadratic formula to solve $ax^2 + bx + c = 0$:\n\n$x = \\dfrac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}$\n\nIn our case, $a = -6, b = -3, c = 6$","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\nx \u0026= \\dfrac{-(-3) \\pm \\sqrt{(-3)^{2} - 4 \\cdot -6 \\cdot 6}}{2 \\cdot -6}\n\\\\\\\\\n\u0026= \\dfrac{3 \\pm \\sqrt{153}}{-12}\n\\\\\\\\\n\u0026= \\dfrac{3 \\pm 3\\sqrt{17}}{-12}\n\\\\\\\\\n\u0026=\\dfrac{1 \\pm \\sqrt{17}}{-4}\n\\end{align}$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Solve.**\n\n$6- 6x^2- 3x = 0$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$x =\\dfrac{7 \\pm \\sqrt{193}}{-12}$","correct":false},{"content":"$x =\\dfrac{5 \\pm \\sqrt{57}}{16}$","correct":false},{"content":"$x =\\dfrac{1 \\pm \\sqrt{17}}{-4}$","correct":true},{"content":"$x =\\dfrac{-4 \\pm \\sqrt{34}}{3}$","correct":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"onePerLine":true,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
