{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Get the equation into the form $ax^2 + bx + c = 0$:\n\n$\\begin{align}\n-8x + 10 - 3x^2 \u0026= -12x\n\\\\\\\\\n4x + 10 - 3x^2 \u0026= 0\n\\\\\\\\\n-3x^{2}+4x+10 \u0026= 0 \n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"Use the quadratic formula to solve $ax^2 + bx + c = 0$:\n\n$x = \\dfrac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}$\n\nIn our case, $a = -3, b = 4, c = 10$","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\nx\u0026=\\dfrac{-4 \\pm \\sqrt{4^{2} - 4 \\cdot -3 \\cdot 10}}{2 \\cdot -3}\n\\\\\\\\\n\u0026= \\dfrac{-4 \\pm \\sqrt{136}}{-6}\n\\\\\\\\\n\u0026= \\dfrac{-4 \\pm 2\\sqrt{34}}{-6}\n\\\\\\\\\n\u0026=\\dfrac{-2 \\pm \\sqrt{34}}{-3}\n\\end{align}$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Solve.**\n\n$-8x + 10 - 3x^2 = -12x$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$x =1,-\\frac{1}{2}$","correct":false},{"content":"$x =\\dfrac{-3 \\pm \\sqrt{17}}{2}$","correct":false},{"content":"$x =\\dfrac{-1 \\pm \\sqrt{129}}{8}$","correct":false},{"content":"$x =\\dfrac{-2 \\pm \\sqrt{34}}{-3}$","correct":true}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"onePerLine":true,"randomize":false},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
