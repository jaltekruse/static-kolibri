{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Recall that $\\blueD{\\dfrac{d}{dx}[\\text{ln}(x)]=\\dfrac1x}$ and $\\maroonD{\\dfrac{d}{dx}[x^n]=nx^{n-1}}$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\dfrac{d}{dx}[-\\text{ln}(x)+x^2]\n\\\\\\\\\n\u0026=-1\\cdot\\blueD{\\dfrac{d}{dx}[\\text{ln}(x)]}+\\maroonD{\\dfrac{d}{dx}[x^2]}\n\\\\\\\\\n\u0026=-1\\cdot\\blueD{\\dfrac1x}+(\\maroonD{2x^1})\n\\\\\\\\\n\u0026=-\\dfrac1x+2x\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$\\dfrac{d}{dx}[-\\text{ln}(x)+x^2]=-\\dfrac1x+2x$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\dfrac{d}{dx}[-\\text{ln}(x)+x^2]=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"-\\frac{1}{x}+2x"}],"buttonSets":["basic","trig","prealgebra","logarithms"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
