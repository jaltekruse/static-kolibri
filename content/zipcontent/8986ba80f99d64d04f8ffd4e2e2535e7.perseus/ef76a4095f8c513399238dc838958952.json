{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Recall that $\\blueD{\\dfrac{d}{dx}[\\text{ln}(x)]=\\dfrac1x}$ and $\\maroonD{\\dfrac{d}{dx}[\\text{cos}(x)]=-\\text{sin}(x)}$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\dfrac{d}{dx}[2\\text{cos}(x)-3\\text{ln}(x)-1]\n\\\\\\\\\n\u0026=2\\maroonD{\\dfrac{d}{dx}[\\text{cos}(x)]}-3\\blueD{\\dfrac{d}{dx}[\\text{ln}(x)]}-\\dfrac{d}{dx}[1]\n\\\\\\\\\n\u0026=2[\\maroonD{-\\text{sin}(x)}]-3\\cdot\\blueD{\\dfrac1x}-0\n\\\\\\\\\n\u0026=-2\\text{sin}(x)-\\dfrac3x\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$\\dfrac{d}{dx}[2\\text{cos}(x)-3\\text{ln}(x)-1]=-2\\text{sin}(x)-\\dfrac3x$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\dfrac{d}{dx}[2\\text{cos}(x)-3\\text{ln}(x)-1]=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"-2\\sin(x)-\\frac{3}{x}"}],"buttonSets":["basic","trig","prealgebra","logarithms"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
