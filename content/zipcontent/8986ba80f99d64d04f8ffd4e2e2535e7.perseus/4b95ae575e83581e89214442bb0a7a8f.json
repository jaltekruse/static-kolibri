{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Recall that $\\blueD{\\dfrac{d}{dx}[e^x]=e^x}$ and $\\maroonD{\\dfrac{d}{dx}[\\text{cos}(x)]=-\\text{sin}(x)}$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\dfrac{d}{dx}[7\\text{cos}(x)+3e^x]\n\\\\\\\\\n\u0026=7\\maroonD{\\dfrac{d}{dx}[\\text{cos}(x)]}+3\\blueD{\\dfrac{d}{dx}[e^x]}\n\\\\\\\\\n\u0026=7[\\maroonD{-\\text{sin}(x)}]+3\\blueD{e^x}\n\\\\\\\\\n\u0026=-7\\text{sin}(x)+3e^x\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$\\dfrac{d}{dx}[7\\text{cos}(x)+3e^x]=-7\\text{sin}(x)+3e^x$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\dfrac{d}{dx}[7\\text{cos}(x)+3e^x]=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"-7\\sin(x)+3e^x"}],"buttonSets":["basic","trig","prealgebra"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
