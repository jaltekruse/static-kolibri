{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Recall that $\\blueD{\\dfrac{d}{dx}[\\text{ln}(x)]=\\dfrac1x}$ and $\\maroonD{\\dfrac{d}{dx}[\\text{sin}(x)]=\\text{cos}(x)}$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\nf'(x)\u0026=\\dfrac{d}{dx}[-4\\text{sin}(x)-9\\text{ln}(x)+11]\n\\\\\\\\\n\u0026=-4\\maroonD{\\dfrac{d}{dx}[\\text{sin}(x)]}-9\\blueD{\\dfrac{d}{dx}[\\text{ln}(x)]}+\\dfrac{d}{dx}[11]\n\\\\\\\\\n\u0026=-4\\cdot\\maroonD{\\text{cos}(x)}-9\\cdot\\blueD{\\dfrac1x}+0\n\\\\\\\\\n\u0026=-4\\text{cos}(x)-\\dfrac9x\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$f'(x)=-4\\text{cos}(x)-\\dfrac9x$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"Let $f(x)=-4\\text{sin}(x)-9\\text{ln}(x)+11$.\n\n$f'(x)=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"-4\\cos(x)-\\frac{9}{x}"}],"buttonSets":["basic","trig","prealgebra","logarithms"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
