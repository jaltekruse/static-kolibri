{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Recall that $\\blueD{\\dfrac{d}{dx}[\\text{ln}(x)]=\\dfrac1x}$ and $\\maroonD{\\dfrac{d}{dx}[x^n]=nx^{n-1}}$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\ng'(x)\u0026=\\dfrac{d}{dx}[3x^4-7\\text{ln}(x)]\n\\\\\\\\\n\u0026=3\\maroonD{\\dfrac{d}{dx}[x^4]}-7\\blueD{\\dfrac{d}{dx}[\\text{ln}(x)]}\n\\\\\\\\\n\u0026=3(\\maroonD{4x^3})-7\\cdot\\blueD{\\dfrac1x}\n\\\\\\\\\n\u0026=12x^3-\\dfrac7x\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$g'(x)=12x^3-\\dfrac7x$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"Let $g(x)=3x^4-7\\text{ln}(x)$.\n\n$g'(x)=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"12x^3-\\frac{7}{x}"}],"buttonSets":["basic","prealgebra","logarithms"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
