{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Recall that $\\blueD{\\dfrac{d}{dx}[\\text{ln}(x)]=\\dfrac1x}$ and $\\maroonD{\\dfrac{d}{dx}[\\text{sin}(x)]=\\text{cos}(x)}$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\dfrac{d}{dx}[3\\text{ln}(x)-12\\text{sin}(x)]\n\\\\\\\\\n\u0026=3\\blueD{\\dfrac{d}{dx}[\\text{ln}(x)]}-12\\maroonD{\\dfrac{d}{dx}[\\text{sin}(x)]}\n\\\\\\\\\n\u0026=3\\cdot\\blueD{\\dfrac1x}-12\\cdot\\maroonD{\\text{cos}(x)}\n\\\\\\\\\n\u0026=\\dfrac3x-12\\text{cos}(x)\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$\\dfrac{d}{dx}[3\\text{ln}(x)-12\\text{sin}(x)]=\\dfrac3x-12\\text{cos}(x)$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\dfrac{d}{dx}[3\\text{ln}(x)-12\\text{sin}(x)]=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"\\frac{3}{x}-12\\cos(x)"}],"buttonSets":["basic","trig","prealgebra","logarithms"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
