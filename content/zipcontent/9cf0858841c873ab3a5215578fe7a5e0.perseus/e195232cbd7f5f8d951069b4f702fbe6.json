dD a \\sin(\\greenD bx+\\purpleC c)+\\gray d"},"type":"label"},{"key":"line-fddb99","options":{"arrows":"","color":"#FF00AF","endX":"10","endY":"x_3+7.5","startX":"-5","startY":"x_3+7.5","strokeDasharray":"- ","strokeWidth":2},"type":"line"}],"graph":{"box":[400,400],"gridStep":[1,1],"labels":["x","y"],"markings":"graph","range":[[-10,10],[-10,10]],"tickStep":[1,1]},"static":false},"static":false,"type":"interaction","version":{"major":0,"minor":0}},"interaction 2":{"alignment":"default","graded":true,"id":"interaction 2","options":{"elements":[{"key":"line-8e8555","options":{"arrows":"","color":"#DF0030","endX":"-5","endY":"9","startX":"-10","startY":"9","strokeDasharray":"","strokeWidth":2},"type":"line"},{"key":"line-2a584e","options":{"arrows":"","color":"#28AE7B","endX":"-5","endY":"6","startX":"-10","startY":"6","strokeDasharray":"","strokeWidth":2},"type":"line"},{"key":"line-54c1f5","options":{"arrows":"","color":"#9D38BD","endX":"-5","endY":"3","startX":"-10","startY":"3","strokeDasharray":"","strokeWidth":2},"type":"line"},{"key":"line-3c946e","options":{"arrows":"","color":"gray","endX":"-5","endY":"-3","startX":"-10","startY":"-3","strokeDasharray":"","strokeWidth":2},"type":"line"},{"key":"movable-point-ce743a","options":{"constraint":"none","constraintFn":"0","constraintXMax":"-5","constraintXMin":"-10","constraintYMax":"9","constraintYMin":"9","snap":0.5,"startX":"-6.5","startY":"9","varSubscript":0},"type":"movable-point"},{"key":"movable-point-96e95f","options":{"constraint":"none","constraintFn":"0","constraintXMax":"-5","constraintXMin":"-10","constraintYMax":"6","constraintYMin":"6","snap":0.5,"startX":"-6.5","startY":"6","varSubscript":1},"type":"movable-point"},{"key":"movable-point-7bc646","options":{"constraint":"none","constraintFn":"0","constraintXMax":"-5","constraintXMin":"-10","constraintYMax":"3","constraintYMin":"3","snap":0.5,"startX":"-7.5","startY":"3","varSubscript":2},"type":"movable-point"},{"key":"movable-point-877012","options"