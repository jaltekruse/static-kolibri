{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"Notice that we can rewrite the integral as $\\displaystyle \\int (\\ln x)^2\\cdot \\,\\dfrac1x\\, dx\\,$.\n\n ","images":{},"replace":false,"widgets":{}},{"content":"If we let $\\blueD {u=\\ln(x)}$, then $\\purpleD{du=\\dfrac1x \\, dx}$.  \n\nSubstituting gives us:\n\n$\\displaystyle \\int (\\blueD{\\ln x})^2\\cdot \\,\\purpleD{\\dfrac1x\\, dx}\\,=\\displaystyle \\int \\blueD u^2\\, \\purpleD{du}\\,$","images":{},"replace":false,"widgets":{}},{"content":"We recognize this antiderivative.\n\n$\\begin{align}\\phantom{\\displaystyle\\int\\dfrac{e^x}{1+e^{2x}}dx}\u0026= \\displaystyle \\int  u^2\\, {du}\\,\\\\\\\\\\\\\n\u0026=\\dfrac{u^3}{3}+C\\end{align}$\n\n","images":{},"replace":false,"widgets":{}},{"content":"We can now substitute back to find the antiderivative in terms of $x$.\n\n$\\begin{align}\\phantom{\\displaystyle\\int\\dfrac{e^x}{1+e^{2x}}dx~}\u0026=~\\dfrac{u^3}{3}+C\\\\\\\\\\\\\\\n\u0026=~\\dfrac{(\\ln x)^3}{3}+C\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"The answer:\n\n$\\displaystyle\\int \\dfrac{(\\ln{x})^2}{x}\\,dx\\,=~\\dfrac{(\\ln x)^3}{3}+C$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\displaystyle\\int \\dfrac{(\\ln{x})^2}{x}\\,dx\\,=$\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$\\displaystyle (\\ln x)^2+C$","correct":false},{"content":"$\\displaystyle (\\ln x)^3+C$","correct":false},{"content":"$\\displaystyle \\dfrac{(\\ln x)^3}{3}+C$","correct":true},{"content":"$\\displaystyle 2\\ln x+C$","correct":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"onePerLine":true,"randomize":true},"static":false,"type":"radio","version":{"major":1,"minor":0}}}}}
