{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"If we let $\\blueD {u=2x-5}$, then ${du=2 \\, dx}$ and $\\purpleD{dx=\\dfrac{du}{2}}$.  \n\nSubstituting gives us:\n\n$\\begin{align}\\displaystyle\\int(\\blueD{2x-5})^{10}\\,\\purpleD {dx}\\,\u0026=\\displaystyle \\int \\blueD u^{10}\\,\\cdot \\purpleD{\\dfrac{du}{2}}\\,\\\\\\\\\\\\\n\u0026=\\displaystyle \\int u^{10}\\cdot \\dfrac12\\, du\\\\\\\\\\\\\n\u0026=\\dfrac12\\displaystyle \\int  u^{10}\\,du\\,\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"We recognize this antiderivative.\n\n$\\begin{align}\\phantom{\\displaystyle\\int\\dfrac{e^x}{1+e^{2x}}dx}\u0026=\\dfrac12\\displaystyle \\int  u^{10}\\,du\\,\\\\\\\\\\\\\n\u0026=\\dfrac12\\cdot \\dfrac{u^{11}}{11}+C\\\\\\\\\\\\\n\u0026=\\dfrac{u^{11}}{22}+C\\end{align}$\n\n","images":{},"replace":false,"widgets":{}},{"content":"We can now substitute back to find the antiderivative in terms of $x$.\n\n$\\begin{align}\\phantom{\\displaystyle\\int\\dfrac{e^x}{1+e^{2x}}dx~}\u0026=\\dfrac{u^{11}}{22}+C\\\\\\\\\\\\\\\n\u0026=\\dfrac{(2x-5)^{11}}{22}+C\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"The answer:\n\n$\\displaystyle\\int(2x-5)^{10}dx\\,=\\dfrac{(2x-5)^{11}}{22}+C$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":" $\\displaystyle\\int(2x-5)^{10}dx\\,=$ \n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"$\\displaystyle\\dfrac{(2x-5)^{11}}{11}+C$","correct":false},{"content":"$\\displaystyle\\dfrac{(2x-5)^{11}}{22}+C$","correct":true},{"content":"$\\displaystyle\\dfrac{(2x-5)^{9}}{9}+C$","correct":false},{"content":"$\\displaystyle\\dfrac{(2x-5)^{9}}{18}+C$","correct":false}],"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"multipleSelect":false,"onePerLine":true,"randomize":true},"static":false,"type