{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The integrand is of the form $x^n$ where $n\\neq-1$, so we can use the reverse power rule:\n\n$\\displaystyle\\int x^n\\,dx=\\dfrac{x^{n+1}}{n+1}+C$","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\\displaystyle\\int x\\,dx\u0026=\\displaystyle\\int x^{\\blueD{1}}\\,dx\n\\\\\\\\\n\u0026=\\dfrac{x^{\\blueD{1}+1}}{\\blueD{1}+1}+C\n\\\\\\\\\n\u0026=\\dfrac12 x^2+C\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$\\displaystyle\\int x\\,dx=\\dfrac12 x^2+C$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\displaystyle\\int x\\,dx=$ [[☃ expression 1]]$+C$","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":"0","simplify":false,"value":"\\frac{x^{2}}{2}"}],"buttonSets":["basic","prealgebra"],"functions":["f","g","h"],"static":false,"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
