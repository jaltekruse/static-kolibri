{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The expression to differentiate includes $\\cos(x)$.\n\nRemember that the derivative of $\\cos(x)$ is $-\\sin(x)$.\n\nPut another way, $\\dfrac{d}{dx}[\\cos(x)]=-\\sin(x)$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\dfrac{d}{dx}[\\cos(x)-7x]\n\\\\\\\\\n\u0026=\\dfrac{d}{dx}[\\cos(x)]-7\\dfrac{d}{dx}(x)\n\\\\\\\\\n\u0026=-\\sin(x)-7\\cdot1\n\\\\\\\\\n\u0026=-\\sin(x)-7\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$\\dfrac{d}{dx}[\\cos(x)-7x]=-\\sin(x)-7$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\dfrac{d}{dx}[\\cos(x)-7x]=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"-\\sin\\left(x\\right)-7"}],"buttonSets":["basic","trig"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
