{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The expression to differentiate includes $\\sin(x)$.\n\nRemember that the derivative of $\\sin(x)$ is $\\cos(x)$.\n\nPut another way, $\\dfrac{d}{dx}[\\sin(x)]=\\cos(x)$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\dfrac{d}{dx}[8\\sin(x)-x]\n\\\\\\\\\n\u0026=8\\dfrac{d}{dx}[\\sin(x)]-\\dfrac{d}{dx}(x)\n\\\\\\\\\n\u0026=8\\cdot \\cos(x)-1\n\\\\\\\\\n\u0026=8\\cos(x)-1\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$\\dfrac{d}{dx}[8\\sin(x)-x]=8\\cos(x)-1$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\dfrac{d}{dx}[8\\sin(x)-x]=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"8\\cos\\left(x\\right)-1"}],"buttonSets":["basic","trig"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
