{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The expression to differentiate includes $\\cos(x)$.\n\nRemember that the derivative of $\\cos(x)$ is $-\\sin(x)$.\n\nPut another way, $\\dfrac{d}{dx}[\\cos(x)]=-\\sin(x)$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\dfrac{d}{dx}[x^3-\\cos(x)]\n\\\\\\\\\n\u0026=\\dfrac{d}{dx}(x^3)-\\dfrac{d}{dx}[\\cos(x)]\n\\\\\\\\\n\u0026=3x^2-(-\\sin(x))\n\\\\\\\\\n\u0026=3x^2+\\sin(x)\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$\\dfrac{d}{dx}[x^3-\\cos(x)]=3x^2+\\sin(x)$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\dfrac{d}{dx}[x^3-\\cos(x)]=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":"0","simplify":false,"value":"3x^{2}+\\sin\\left(x\\right)"}],"buttonSets":["basic","trig","prealgebra"],"functions":["f","g","h"],"static":false,"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
