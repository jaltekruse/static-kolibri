{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The expression for $f(x)$ includes $\\sin(x)$.\n\nRemember that the derivative of $\\sin(x)$ is $\\cos(x)$.\n\nPut another way, $\\dfrac{d}{dx}[\\sin(x)]=\\cos(x)$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\nf'(x)\u0026=\\dfrac{d}{dx}[7\\sin(x)-2x^3]\n\\\\\\\\\n\u0026=7\\dfrac{d}{dx}[\\sin(x)]-2\\dfrac{d}{dx}(x^3)\n\\\\\\\\\n\u0026=7\\cdot\\cos(x)-2\\cdot3x^2\n\\\\\\\\\n\u0026=7\\cos(x)-6x^2\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$f'(x)=7\\cos(x)-6x^2$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"Let $f(x)=7\\sin(x)-2x^3$.\n\n$f'(x)=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":"0","simplify":false,"value":"7\\cos\\left(x\\right)-6x^{2}"}],"buttonSets":["basic","trig","prealgebra"],"functions":["f","g","h"],"static":false,"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
