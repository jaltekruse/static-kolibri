{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The expression to differentiate includes $\\cos(x)$.\n\nRemember that the derivative of $\\cos(x)$ is $-\\sin(x)$.\n\nPut another way, $\\dfrac{d}{dx}[\\cos(x)]=-\\sin(x)$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\dfrac{d}{dx}[-5x^2-4\\cos(x)]\n\\\\\\\\\n\u0026=-5\\dfrac{d}{dx}(x^2)-4\\dfrac{d}{dx}[\\cos(x)]\n\\\\\\\\\n\u0026=-5\\cdot 2x-4(-\\sin(x))\n\\\\\\\\\n\u0026=-10x+4\\sin(x)\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$\\dfrac{d}{dx}[-5x^2-4\\cos(x)]=-10x+4\\sin(x)$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\dfrac{d}{dx}[-5x^2-4\\cos(x)]=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"-10x+4\\sin\\left(x\\right)"}],"buttonSets":["basic","trig"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
