{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The expression to differentiate includes $\\cos(x)$.\n\nRemember that the derivative of $\\cos(x)$ is $-\\sin(x)$.\n\nPut another way, $\\dfrac{d}{dx}[\\cos(x)]=-\\sin(x)$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\n\u0026\\phantom{=}\\dfrac{d}{dx}[3\\cos(x)+4x^2]\n\\\\\\\\\n\u0026=3\\dfrac{d}{dx}[\\cos(x)]+4\\dfrac{d}{dx}(x^2)\n\\\\\\\\\n\u0026=3(-\\sin(x))+4\\cdot2x\n\\\\\\\\\n\u0026=-3\\sin(x)+8x\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$\\dfrac{d}{dx}[3\\cos(x)+4x^2]=-3\\sin(x)+8x$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"$\\dfrac{d}{dx}[3\\cos(x)+4x^2]=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"-3\\sin\\left(x\\right)+8x"}],"buttonSets":["basic","trig"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
