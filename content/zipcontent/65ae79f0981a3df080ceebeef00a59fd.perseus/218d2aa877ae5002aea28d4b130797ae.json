{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The expression for $h(x)$ includes $\\cos(x)$.\n\nRemember that the derivative of $\\cos(x)$ is $-\\sin(x)$.\n\nPut another way, $\\dfrac{d}{dx}[\\cos(x)]=-\\sin(x)$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\nh'(x)\u0026=\\dfrac{d}{dx}[9\\cos(x)-7x^2]\n\\\\\\\\\n\u0026=9\\dfrac{d}{dx}[\\cos(x)]-7\\dfrac{d}{dx}(x^2)\n\\\\\\\\\n\u0026=9(-\\sin(x))-7\\cdot2x\n\\\\\\\\\n\u0026=-9\\sin(x)-14x\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$h'(x)=-9\\sin(x)-14x$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"Let $h(x)=9\\cos(x)-7x^2$.\n\n$h'(x)=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"-9\\sin\\left(x\\right)-14x"}],"buttonSets":["basic","trig"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
