{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"The expression for $h(x)$ includes $\\sin(x)$.\n\nRemember that the derivative of $\\sin(x)$ is $\\cos(x)$.\n\nPut another way, $\\dfrac{d}{dx}[\\sin(x)]=\\cos(x)$.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align}\nh'(x)\u0026=\\dfrac{d}{dx}[-6\\sin(x)-3x]\n\\\\\\\\\n\u0026=-6\\dfrac{d}{dx}[\\sin(x)]-3\\dfrac{d}{dx}(x)\n\\\\\\\\\n\u0026=-6\\cdot\\cos(x)-3\\cdot1\n\\\\\\\\\n\u0026=-6\\cos(x)-3\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"In conclusion,\n\n$h'(x)=-6\\cos(x)-3$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"Let $h(x)=-6\\sin(x)-3x$.\n\n$h'(x)=$ [[☃ expression 1]]","images":{},"widgets":{"expression 1":{"alignment":"default","graded":true,"options":{"answerForms":[{"considered":"correct","form":false,"key":0,"simplify":false,"value":"-6\\cos\\left(x\\right)-3"}],"buttonSets":["basic","trig"],"functions":["f","g","h"],"times":false},"static":false,"type":"expression","version":{"major":1,"minor":0}}}}}
