{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"We need to manipulate the equation to get $  m   $ by itself.","images":{},"replace":false,"widgets":{}},{"content":"$\\begin{align} m \u0026=  -(4+m)+2 \\\\\\\\\nm \u0026= -4-m+2\u0026\u0026\\small\\gray{\\text{Distribute}}\\\\\\\\\nm \u0026= -2-m\u0026\u0026\\small\\gray{\\text{Combine like terms}}\\\\\\\\\nm\\blueD{+m} \u0026= -2-m\\blueD{+m} \u0026\u0026\\small\\gray{\\text{Add m to each side}}\\\\\\\\\n2m\u0026=-2 \u0026\u0026\\small\\gray{\\text{Combine like terms}}\\\\\\\\\n\\dfrac{2m}{\\blueD{2}}\u0026= \\dfrac{-2}{\\blueD{2}}\u0026\u0026\\small\\gray{\\text{Divide each side by 2}} \\\\\\\\\nm \u0026= \\greenD{-1} \u0026\u0026\\small\\gray{\\text{Simplify}}\n\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"**The answer:**\n\n$   m =\\greenD{-1}~~~~~~~~$ [[☃ explanation 1]]","images":{},"replace":false,"widgets":{"explanation 1":{"alignment":"default","graded":true,"options":{"explanation":"$\\begin{align} m \u0026=  -(4+m)+2 \\\\\\\\\n\\greenD{-1} \u0026\\stackrel?= -(4+(\\greenD{-1}))+2 \\\\\\\\\n-1 \u0026\\stackrel?= -(3)+2 \\\\\\\\\n -1\u0026\\stackrel?= -3+2 \\\\\\\\\n -1\u0026=-1  ~~~~~~~\\text{Yes!}\n\\end{align}$","hidePrompt":"Okay, got it","showPrompt":"Let's check our work!","static":false,"widgets":{}},"static":false,"type":"explanation","version":{"major":0,"minor":0}}}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Solve for $m$.**\n\n$m=-(4+m)+2$\n\n$m =$ [[☃ numeric-input 1]]","images":{},"widgets":{"numeric-input 1":{"alignment":"default","graded":true,"options":{"answers":[{"maxError":null,"message":"","simplify":"optional","status":"correct","strict":false,"value":-1}],"coefficient":false,"labelText":"","multipleNumberInput":false,"size":"normal","static":false},"static":false,"type":"numeric-input","version":{"major":0,"minor":0}}}}}
