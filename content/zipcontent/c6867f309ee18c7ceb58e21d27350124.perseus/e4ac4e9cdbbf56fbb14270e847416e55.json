{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"First, use the power rule:\n\n$\\begin{align}\\displaystyle\\int^2_{1}\\left(\\dfrac{12}{x^2}-1\\right)\\,dx~\u0026=\\displaystyle\\int^2_{1}\\left(12x^{-2}-1\\right)\\,dx\n\\\\\u0026=~(-12x^{-1}-x)\\Bigg|^\\blueD2_{\\maroonD1}\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"Second, plug in the limits of integration:\n\n$[-12\\cdot\\blueD2^{-1}-\\blueD2]-[-12\\cdot\\maroonD1^{-1}-\\maroonD1] = -8+13 = 5$.","images":{},"replace":false,"widgets":{}},{"content":"The answer:\n\n$\\displaystyle\\int^2_{1}\\left(\\dfrac{12}{x^2}-1\\right)\\,dx = 5$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Evaluate the definite integral.**\n\n$\\displaystyle\\int^2_{1}\\left(\\dfrac{12}{x^2}-1\\right)\\,dx = $ [[☃ numeric-input 1]]","images":{},"widgets":{"numeric-input 1":{"alignment":"default","graded":true,"options":{"answers":[{"maxError":null,"message":"","simplify":"required","status":"correct","strict":false,"value":5}],"coefficient":false,"labelText":"","size":"normal","static":false},"static":false,"type":"numeric-input","version":{"major":0,"minor":0}}}}}
