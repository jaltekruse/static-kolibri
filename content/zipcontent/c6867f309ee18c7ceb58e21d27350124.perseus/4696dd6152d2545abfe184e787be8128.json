{"answerArea":{"calculator":false,"chi2Table":false,"periodicTable":false,"tTable":false,"zTable":false},"hints":[{"content":"First, use the power rule:\n\n$\\begin{align}\\displaystyle\\int^4_{3}\\left(4+\\dfrac{24}{x^2}\\right)\\,dx~\u0026= \\displaystyle\\int^4_{3}\\left(4+24x^{-2}\\right)\\,dx\n\\\\\u0026=\n~(4x-24x^{-1})\\Bigg|^\\blueD4_{\\maroonD3}\\end{align}$","images":{},"replace":false,"widgets":{}},{"content":"Second, plug in the limits of integration:\n\n$[4\\cdot\\blueD4-24\\cdot\\blueD4^{-1}]-[4\\cdot\\maroonD3-24\\cdot\\maroonD3^{-1}] = 10-4 = 6$.","images":{},"replace":false,"widgets":{}},{"content":"The answer:\n\n$\\displaystyle\\int^4_{3}\\left(4+\\dfrac{24}{x^2}\\right)\\,dx = 6$","images":{},"replace":false,"widgets":{}}],"itemDataVersion":{"major":0,"minor":1},"question":{"content":"**Evaluate the definite integral.**\n\n$\\displaystyle\\int^4_{3}\\left(4+\\dfrac{24}{x^2}\\right)\\,dx = $ [[☃ numeric-input 1]]","images":{},"widgets":{"numeric-input 1":{"alignment":"default","graded":true,"options":{"answers":[{"maxError":null,"message":"","simplify":"required","status":"correct","strict":false,"value":6}],"coefficient":false,"labelText":"","size":"normal","static":false},"static":false,"type":"numeric-input","version":{"major":0,"minor":0}}}}}
