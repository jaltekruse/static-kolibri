r":0}}}},{"content":"$ =\\dfrac{288}{128}\\qquad$  [[☃ explanation 3]]","images":{},"replace":false,"widgets":{"explanation 3":{"alignment":"default","graded":true,"options":{"explanation":"Here's how we multiplied the fractions:\n\n$\\phantom{=}32 \\cdot \\dfrac9{128}$\n\n$ =\\dfrac{32 \\cdot 9}{1 \\cdot 128}$\n\n$=\\dfrac{288}{128}$","hidePrompt":"Hide explanation","showPrompt":"Explain","static":false,"widgets":{}},"static":false,"type":"explanation","version":{"major":0,"minor":0}}}},{"content":"$ =\\dfrac{9}{4}$ dollars per kilometer $\\qquad$  [[☃ explanation 4]]","images":{},"replace":false,"widgets":{"explanation 4":{"alignment":"default","graded":true,"options":{"explanation":"Here's how we simplified the fraction:\n\n$ \\phantom{=}\\dfrac{288}{128}$\n\n$= \\dfrac{9 \\cdot \\cancel{32}}{4 \\cdot \\cancel{32}}$\n\n$ = \\dfrac{9}{4}$","hidePrompt":"Hide explanation","showPrompt":"Explain","static":false,"widgets":{}},"static":false,"type":"explanation","version":{"major":0,"minor":0}}}},{"content":"Each kilometer, the cost is $\\$2.25$.","images":{},"replace":false,"widgets":{}}],"question":{"content":"Emanuel was charged $\\$32$ for a $14\\dfrac29 \\text{ km}$ taxi ride. The cost per kilometer is constant.\n\n**What was the cost per kilometer?**  \n*Enter an exact answer, without rounding.*\n\n$\\$$ [[☃ numeric-input 1]]","images":{},"widgets":{"numeric-input 1":{"alignment":"default","graded":true,"options":{"answers":[{"answerForms":["proper","improper"],"maxError":null,"message":"","simplify":"required","status":"correct","strict":false,"value":2.25}],"coefficient":false,"labelText":"","multipleNumberInput":false,"rightAlign":false,"size":"normal","static":false},"static":false,"type":"numeric-input","version":{"major":0,"minor":0}}}}}
